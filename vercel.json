{
  "version": 2,
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "status": 307,
      "headers": { "Location": "/api/actuator" }
    },
    {
      "src": "/(.*)",
      "dest": "dist/main.js"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
